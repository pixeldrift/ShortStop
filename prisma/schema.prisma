// ShortStop's Postgres schema - the source of truth this app's API
// routes read from, replacing direct client-side fetches of the CSV/
// JSON files under public/data/ (see prisma/seed.ts, which loads those
// same files in once to populate this). Those files stay in the repo
// as the district's original source documents (and as seed input) -
// see README.

generator client {
  provider = "prisma-client-js"
}

// No `url` here - Prisma 7 moved the connection string to
// prisma.config.ts (CLI commands: migrate, generate, studio) and to
// the driver adapter passed into `new PrismaClient()` at runtime (see
// src/lib/db.ts) - a bare datasource `url` is rejected at schema-load
// time now, not just ignored.
datasource db {
  provider = "postgresql"
}

enum SchoolLevelDb {
  elementary
  middle
  high
}

enum TripTypeDb {
  pickup
  dropoff
  fieldtrip
  other
}

// Only "published"/"draft" - the app's own third status, "demo", marks
// entirely fabricated filler routes (src/lib/demoRoutes.ts) that never
// come from real data and so never get a database row - see
// RouteStatus's doc comment in src/lib/types.ts.
enum RouteStatusDb {
  published
  draft
}

model School {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  // Split from schools.csv's own single combined "{street}, {city},
  // {ST} {zip}" address column (see src/lib/schoolAddress.ts's
  // parseAddress/formatAddress - the seed script splits it going in,
  // src/app/api/schools/route.ts joins it back going out, so the
  // wire format every existing consumer of SchoolInfo.address already
  // relies on never has to change).
  street    String
  city      String
  state     String
  zip       String
  level     SchoolLevelDb
  // The school's own geocoded location - independent of the Waypoint
  // cache below, which only ever learns a school's address as a side
  // effect of resolving one of its routes' intersection-kind stops
  // (see resolveWaypoint.ts's ensureAnchor). A school with no routes
  // yet, or whose routes are all address-kind stops, never triggers
  // that path - these columns are geocoded directly from every
  // school's own address (scripts/geocodeSchools.ts) so every school
  // has a real coordinate regardless of its routes. Null until that's
  // run for a given school.
  lat       Float?
  lon       Float?
  // True once a human has actually confirmed lat/lon are correct -
  // set for now by scripts/fixSchoolCoordinates.ts's own hand-checked
  // corrections, not by anything automated (an ORS "ok" status means
  // ORS found *a* match, not that anyone confirmed it's the right
  // one - see that script's own doc). scripts/geocodeSchools.ts never
  // overwrites a verified row, even with --force. There's no UI path
  // that lets a user edit a school's own details at all (its address/
  // level/coordinates only ever come from schools.csv by way of this
  // table - see EditRouteScreen.tsx's school picker, a plain <select>
  // with no free-text school fields), so this can only ever be set by
  // a script/admin action like that one, never a stray edit.
  verified  Boolean       @default(false)

  @@map("schools")
}

// One row per real route (Route.id's `${routeNumber}-${tripType}-
// ${schoolLevel}` convention - see src/lib/types.ts), mirroring
// route-master-list.csv. schoolName is kept as its own column rather
// than a foreign key to School - the master list and schools sheet are
// two independently-maintained district documents today, joined by
// name at read time exactly as parseSchoolsCsv/page.tsx already do,
// and a route whose school isn't in the schools sheet yet (data lag,
// not a bug) should still load rather than fail a foreign key.
model Route {
  id            String        @id
  status        RouteStatusDb
  routeNumber   String
  busNumber     String
  schoolName    String
  schoolLevel   SchoolLevelDb
  tripType      TripTypeDb
  // 24-hour "H:MM" / "HH:MM:SS" text, exactly as the district's sheet
  // writes it - see parseRouteMasterList's format24HourAsAmPm/
  // durationBetween24HourTimes, which already parse this shape.
  startTime     String
  // Null means the sheet hasn't recorded when this route ends yet
  // (parseRouteMasterList.ts's durationMinutes stays undefined too, in
  // that case - see page.tsx's own skip-and-warn for such a row).
  endTime       String?
  steps         RouteStep[]
  // EditRouteScreen's own "Next Action" field - reaching the end of
  // this route auto-continues straight into `nextRoute`'s own
  // directions (useRouteStepper.ts) instead of ending the trip, for a
  // bus that drives more than one leg back-to-back (elementary, then
  // middle, then high school, say) without a driver pulling the next
  // route up separately. A self-relation, so it's just another Route
  // row rather than a whole separate "route chain" concept. SetNull
  // (not the default Restrict) so deleting a route that happens to be
  // some other route's own "next" doesn't fail that deletion - it just
  // leaves that other route pointing nowhere again, same as if an
  // admin had picked "None" by hand.
  nextRouteId   String?
  nextRoute     Route?        @relation("RouteNextRoute", fields: [nextRouteId], references: [id], onDelete: SetNull)
  previousRoutes Route[]      @relation("RouteNextRoute")
  updatedAt     DateTime      @updatedAt

  @@map("routes")
}

// One row per data row of a route's own steps sheet (public/data/
// {route}.csv today), in original sheet order - see
// parseRouteCsv.ts's RawRouteRow, whose shape this mirrors exactly.
model RouteStep {
  id         Int     @id @default(autoincrement())
  routeId    String
  route      Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence   Int
  action     String
  // The row's own real position - a turn's destination road, or a
  // stop's own road/intersection/address - always required, always
  // exactly what the district's sheet (or an admin) says this row is
  // at. Replaces the old ontoAt (see the "location + from_location
  // rename" migration) - that name never distinguished "this row's own
  // real place" from fromLocation's "context road," and the ambiguity
  // meant a row whose own from-road had a typo (the district's sheet
  // literally wrote "David Way" for a real "Davids Way") had no field
  // to fix it in at all - EditRouteScreen.tsx only ever showed
  // fromLocation as a read-only label, never an input.
  location   String
  // Optional context: which road this row's own location is being
  // approached from, used to build an intersection pair together with
  // `location` when that alone isn't a full address. Blank means
  // "infer it" - deriveWaypoints.ts still tracks whichever road the
  // route was last known to be on, the same "current road" logic as
  // before, and uses that when this is empty - but unlike the old
  // fromAt, this is a real, always-editable field now, not a read-only
  // inference with no way to override a bad guess or fix a typo in an
  // explicitly-given value.
  fromLocation String
  riderCount String
  side       String
  notes      String
  // Manually marked "instructions only, don't geocode this" from
  // EditRouteScreen.tsx's own Skip checkbox - distinct from
  // deriveWaypoints.ts's own pattern-based "unresolvable" detection
  // (a ramp description, say), which never touches this column at all.
  // Defaults false so every existing/seeded row (none of which have
  // ever set this) reads as "not skipped" without a backfill.
  skip       Boolean @default(false)

  @@unique([routeId, sequence])
  @@map("route_steps")
}

// The geocoding cache - one row per waypointCacheKey(query) (see
// src/lib/waypointCache.ts), shared across every route rather than
// split per-route the way the old *-waypoints.json sidecar files were:
// the key is already content-addressed (the same real-world
// intersection/address resolves to the same key regardless of which
// route's steps sheet asked for it first), so one shared table is
// strictly more useful than several route-scoped files, with no change
// to how a lookup works (still a single key -> entry read).
model Waypoint {
  cacheKey    String   @id
  status      String
  lat         Float?
  lon         Float?
  displayName String?
  source      String
  provider    String
  message     String?
  raw         String?
  // Same meaning as School.verified above (a human confirmed this
  // stop/turn's coordinates, not just that some geocoder returned an
  // "ok" status for it) - not wired into any read/write path yet,
  // added now so a future confirmation step (e.g. an admin marking a
  // route's turns reviewed) has a column to set rather than a schema
  // change of its own.
  verified    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("waypoints")
}
