# Copy this file to .env.local (gitignored) and fill in real values.
# scripts/geocodeRoute.ts (npm run geocode) loads this itself (it runs
# outside Next.js, so it doesn't get Next's automatic .env.local
# loading); Next.js's own dev/build process reads it automatically for
# src/app/api/geocode/route.ts (the Add/Edit Route screen's "Fetch
# Location"/"Fetch All Locations" buttons) - no extra loader needed
# there, just a real key in this file.

# Free key from https://openrouteservice.org/dev/#/signup - used for
# geocoding a route's waypoints (see src/lib/geocode.ts) and,
# eventually, the routing/directions call.
ORS_API_KEY=
