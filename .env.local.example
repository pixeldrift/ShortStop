# Copy this file to .env.local (gitignored) and fill in real values.
# scripts/geocodeRoute.ts (npm run geocode) loads this itself (it runs
# outside Next.js, so it doesn't get Next's automatic .env.local
# loading); Next.js's own dev/build process reads it automatically for
# src/app/api/geocode/route.ts (the Add/Edit Route screen's "Fetch
# Location"/"Fetch All Locations" buttons) - no extra loader needed
# there, just a real key in this file.

# Free key from https://openrouteservice.org/dev/#/signup - used for
# geocoding a route's waypoints (see src/lib/geocode.ts) and for the
# road-following route line drawn on the map (see
# src/lib/routing/providers/openrouteservice.ts and
# src/app/api/route-geometry/route.ts) - one key covers both.
ORS_API_KEY=

# Free key from https://carto.com/ - CARTO's own Voyager basemap tiles
# (src/components/RouteMap.tsx) now require one to serve real imagery
# instead of a watermarked "API KEY REQUIRED" placeholder. NEXT_PUBLIC_
# (unlike ORS_API_KEY above) because Leaflet fetches these tiles
# directly from the browser - this key is not, and can't be, a server
# secret.
NEXT_PUBLIC_CARTO_API_KEY=

# Postgres connection string - routes/schools/waypoint-cache data lives
# here now (see prisma/schema.prisma), read via src/lib/db.ts and the
# API routes under src/app/api/. A local Postgres works fine for dev
# (e.g. `postgresql://postgres:postgres@localhost:5432/shortstop`); a
# free hosted one works too (Neon, Vercel Postgres, Supabase, etc).
# After setting this: `npx prisma migrate dev` to create the schema,
# then `npx prisma db seed` to load public/data/'s CSVs/JSON into it.
DATABASE_URL=
