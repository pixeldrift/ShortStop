{
  "name": "shortstop-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "geocode": "tsc --project scripts/tsconfig.json && node scripts/.dist/scripts/geocodeRoute.js",
    "geocode:schools": "tsc --project scripts/tsconfig.json && node scripts/.dist/scripts/geocodeSchools.js",
    "fix-school-coordinates": "tsc --project scripts/tsconfig.json && node scripts/.dist/scripts/fixSchoolCoordinates.js",
    "fix-misplaced-rider-notes": "tsc --project scripts/tsconfig.json && node scripts/.dist/scripts/fixMisplacedRiderNotes.js",
    "prototype:overpass": "tsc --project scripts/tsconfig.json && node scripts/.dist/scripts/prototypeOverpassGeocode.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.2.8",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "pmtiles": "^4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
